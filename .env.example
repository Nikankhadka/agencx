# Copy to .env (never commit .env). Placeholders only - real values live in your
# local .env and, in production, AWS Secrets Manager / Vercel env vars.

# --- Database (local dev: docker compose up db) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wren
# Backend app role (created by migration 0002; used by the API instead of postgres).
# REQUIRED: min 8 chars, no quotes/backslashes/dollar signs; the migration runner
# fails closed on the placeholder below or unsafe characters.
WREN_APP_DB_PASSWORD=change-me

# --- Supabase (auth) - wired in T-004 ---
# For local demo auth (./scripts/demo.sh), SUPABASE_URL is http://localhost:54321
# (the local GoTrue behind the nginx auth-proxy) and SUPABASE_JWT_SECRET is any
# 64-hex string the script generates. scripts/demo.sh sets both; the anon key
# for frontend/.env.local is minted from this secret by seeds/supabase_keys.py.
# For hosted Supabase, fill these from your project settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# --- Login-in-chat email delivery (O-2) ---
# 'console' logs the code (the local demo path - no SMTP); 'smtp' delivers via a
# standard relay. Adding a vendor (e.g. Resend) is a new provider class, never a
# schema change. The 6-digit code is backend-issued (auth_codes table).
#
# To read the code in a real inbox locally, run `make mail` (Mailpit) and set:
#   EMAIL_PROVIDER=smtp / EMAIL_SMTP_HOST=localhost / EMAIL_SMTP_PORT=1025
#   EMAIL_SMTP_FROM=login@agencx.local
# then open http://localhost:8025. GET /api/auth/dev-login-code keeps working
# either way (local environment only), so the E2E login helper is unaffected.
EMAIL_PROVIDER=console
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_FROM=

# --- Chat LLM provider: 'zai' | 'openai_compat' | 'azure' ---
# 'zai' is the proven free primary: Z.ai's GLM Flash line, with the two Z.ai
# quirks (json_object extract mode, thinking disabled) handled by the provider.
# LLM_BASE_URL empty = the Z.ai default URL.
#   Z.ai: LLM_MODEL=glm-4.7-flash  (LLM_BASE_URL defaults to https://api.z.ai/api/paas/v4/)
# 'openai_compat' works with any OpenAI-compatible endpoint. Free examples:
#   Google AI:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#               LLM_MODEL=gemini-3.5-flash-lite  (key from aistudio.google.com)
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=google/gemma-4-26b-a4b-it:free
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
#               (Groq only supports json_schema structured outputs on its gpt-oss
#               models; llama-3.3-70b-versatile is json_object-only and breaks extract)
#   Ollama:     LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2  (LLM_API_KEY ignored)
# The model must support structured outputs - onboarding and routing rely on it.
# Note: Z.ai only honors the looser json_object mode (strict json_schema is
# rejected), which is why 'zai' is a distinct provider from 'openai_compat'.
LLM_PROVIDER=zai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=glm-4.7-flash

# --- Fallback chat provider (optional) ---
# When LLM_FALLBACK_MODEL + LLM_FALLBACK_API_KEY are set, every LLM call fails
# over to this provider once the primary's internal retries are exhausted
# (transient 429s, unusable upstream bodies, network errors). Leave the model
# empty to disable failover entirely. LLM_FALLBACK_PROVIDER picks the vendor
# class: 'zai' (default) or 'openai_compat'.
# Proven pairings:
#   primary Z.ai -> fallback OpenRouter:  LLM_FALLBACK_PROVIDER=openai_compat
#                                         LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#                                         LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
#   primary Google -> fallback Groq:       LLM_FALLBACK_PROVIDER=openai_compat
#                                          LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
#                                          LLM_FALLBACK_MODEL=openai/gpt-oss-120b
#   primary OpenRouter -> fallback Z.ai:  LLM_FALLBACK_PROVIDER=zai
#                                         LLM_FALLBACK_MODEL=glm-4.7-flash
#                                         (LLM_FALLBACK_BASE_URL empty = Z.ai default)
LLM_FALLBACK_PROVIDER=openai_compat
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free

# --- Azure OpenAI (when LLM_PROVIDER=azure and/or EMBEDDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- Embedder: 'local' (default - free, keyless sentence-transformers) or 'azure' ---
# EMBEDDING_DIM must match knowledge_chunks.embedding's vector(N) (migration
# 0010). The default local model is natively 384; Azure truncates to 384
# server-side, so switching needs no migration - only re-ingesting documents.
EMBEDDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Reranker (T-009): 'cohere' or 'local' ---
RERANKER=local
COHERE_API_KEY=

# --- Observability (Langfuse) - wired in T-030 ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Frontend (frontend/.env.local) ---
# scripts/demo.sh sets all three for local demo (API on :8000, local GoTrue on
# :54321, anon key minted from SUPABASE_JWT_SECRET). For hosted Supabase, use
# your project's URL + anon key.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
