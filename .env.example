# Copy to .env (never commit .env). Placeholders only - real values live in your
# local .env and, in production, AWS Secrets Manager / Vercel env vars.

# --- Database (local dev: docker compose up db) ---
# Local dev. Deployed (B-4), this is the hosted Supabase SESSION POOLER string on
# port 5432. NOT the transaction pooler (6543): Supavisor's transaction mode has
# no prepared statements and asyncpg uses them everywhere, so both the migration
# runner and the app pool die on it. NOT the direct db.<ref>.supabase.co host
# either - that is IPv6-only and does not resolve from Vercel. See deploy.md.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wren
# Backend app role (created by migration 0002; used by the API instead of postgres).
# REQUIRED: min 8 chars, no quotes/backslashes/dollar signs; the migration runner
# fails closed on the placeholder below or unsafe characters.
WREN_APP_DB_PASSWORD=change-me

# --- Supabase (auth) - wired in T-004; login-in-chat is GoTrue OTP ---
# For local dev (./scripts/dev.sh), SUPABASE_URL is http://localhost:54321 (the
# local GoTrue behind the nginx auth-proxy) and SUPABASE_JWT_SECRET is any
# 64-hex string the script generates. scripts/dev.sh sets both; the anon key
# for frontend/.env.local is minted from this secret by seeds/supabase_keys.py.
# For hosted Supabase, fill these from your project settings.
#
# Login-in-chat's 6-digit code is issued and verified by GoTrue itself
# (signInWithOtp/verifyOtp), not by this backend - locally it lands in Mailpit
# (http://localhost:8025, started automatically by `make dev`/`make demo`; see
# docker-compose.yml's `auth` service for the SMTP wiring). There is no
# backend-side email config to set here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# The project's service_role key (Project Settings > API). REQUIRED off local: it
# is what the backend presents to GoTrue's Admin API and to Supabase Storage.
# Projects created since Supabase moved to ES256 session signing have no symmetric
# secret to mint a service token from, so the real key is the only way in. Secret -
# server-side only, never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Chat LLM provider: three tiers, all configuration, no code ---
# Every leg speaks the OpenAI wire format, so swapping vendors is an env change.
# The tiers (architecture.md section 10 / D15):
#
#   | Leg      | Vendor              | Model                        | Why |
#   |----------|---------------------|------------------------------|-----|
#   | primary  | Google AI Studio    | gemini-3.5-flash-lite        | the most generous free limits measured; non-reasoning, so no hidden thinking tax |
#   | fallback | Groq                | openai/gpt-oss-120b          | LPU latency (~1000+ tok/s); cached prefixes do not count toward TPM |
#   | failover | OpenRouter          | google/gemma-4-26b-a4b-it:free | an independent third tier, CI-pinned, 0 reasoning tokens |
#
# A leg is enabled when its MODEL and API_KEY are both set; the chain is built
# in order, and each leg's exhausted retries hand the call to the next one.
#
# Base URLs and quirks per vendor:
#   Google AI:  https://generativelanguage.googleapis.com/v1beta/openai/   (key from aistudio.google.com)
#   Groq:       https://api.groq.com/openai/v1
#               ONLY the gpt-oss models do strict json_schema structured outputs.
#               llama-3.3-70b-versatile is json_object-only and returns prose for
#               every extract() - the startup guard refuses to boot on that pairing.
#   OpenRouter: https://openrouter.ai/api/v1        (free models come and go; check
#               openrouter.ai/api/v1/models for structured_outputs support)
#   Cerebras:   https://api.cerebras.ai/v1          (candidate fallback, $5 free credits)
#   Z.ai:       leave BASE_URL empty and set PROVIDER=zai - Z.ai honors only the
#               looser json_object extract mode, which is why it is its own
#               provider class rather than an openai_compat URL
#   Ollama:     http://localhost:11434/v1           (API key ignored)
#   Azure:      set PROVIDER=azure and the AZURE_* block below
#
# Whatever the lineup, the model MUST support structured outputs: routing,
# onboarding extraction, and inspection all depend on it.
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# --- Fallback leg (optional) ---
LLM_FALLBACK_PROVIDER=openai_compat
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Failover leg (optional third tier) ---
# Deliberately somebody else's infrastructure: the primary and fallback are the
# two fastest free tiers, which makes them the two most likely to be rate-limited
# on the same afternoon.
LLM_FAILOVER_PROVIDER=openai_compat
LLM_FAILOVER_BASE_URL=https://openrouter.ai/api/v1
LLM_FAILOVER_API_KEY=
LLM_FAILOVER_MODEL=google/gemma-4-26b-a4b-it:free

# --- Latency budget (P-2) ---
# Seconds the primary leg gets to produce a first token before the next leg
# starts racing it; first answer wins, the loser is cancelled. The customer
# never sees the switch. A whole turn is capped separately (10s by default, per
# tenant via tenant_config.config.limits.turn_budget_s).
LLM_TTFT_BUDGET_S=4

# --- Live-testing budget (P-1) ---
# The standing ceiling for paid model usage, in dollars per month. The cost
# dashboard warns at 80%. Free tiers report zero cost, so this only bites once a
# paid key is in play - which is exactly when it should.
LLM_MONTHLY_BUDGET_USD=10

# --- Azure OpenAI (when LLM_PROVIDER=azure and/or EMBEDDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- Embedder: 'local' (default - free, keyless sentence-transformers), 'google' or 'azure' ---
# EMBEDDING_DIM must match knowledge_chunks.embedding's vector(N) (migration
# 0010). The default local model is natively 384; Google and Azure both truncate
# to 384 server-side, so switching needs no migration - only re-ingesting
# documents.
#
# The DEPLOYED stack uses 'google' (B-4): the production image ships without
# sentence-transformers, so 'local' is not available there and fails at first
# use by design. 'google' reuses LLM_API_KEY rather than taking a key of its own.
EMBEDDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5
GOOGLE_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIM=384

# --- Reranker (T-009): 'cohere' or 'local' ---
# 'cohere' is the deployed value, for the same reason as EMBEDDER above.
RERANKER=local
COHERE_API_KEY=

# --- Uploads (T-007 / B-4) ---
# UPLOADS_DIR is a local filesystem path, used only while UPLOADS_BUCKET is empty.
# UPLOADS_BUCKET is REQUIRED in any deployment whose disk does not survive between
# requests (Vercel container services): draft_from_upload parks the file, and a
# LATER request reads it back to chunk and embed when the owner saves. On local
# disk that second request can land on another instance, the read raises, and the
# document is silently marked failed - so knowledge upload, the core of
# onboarding, breaks. Set it to a Supabase Storage bucket name; empty keeps
# everything on the filesystem, which is what local dev and the test suite want.
UPLOADS_DIR=var/uploads
UPLOADS_BUCKET=

# --- Cloudinary media (M-2) - server-only signed Upload API credentials ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Observability (Langfuse) - wired in T-030 ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Frontend (frontend/.env.local) ---
# scripts/dev.sh sets all three for local demo (API on :8000, local GoTrue on
# :54321, anon key minted from SUPABASE_JWT_SECRET). For hosted Supabase, use
# your project's URL + anon key.
#
# NEXT_PUBLIC_API_URL is deliberately UNSET in the deploy (B-4): frontend and
# backend are two services behind one Vercel origin, so an empty value makes
# every call a same-origin /api/... Setting an absolute URL there would
# reintroduce the cross-origin request the topology exists to avoid.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
