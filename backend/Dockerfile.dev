# Dev container for the fully containerized local stack (F-3). Toolchain only:
# dependencies live in the wren-backend-venv named volume and are installed by
# `make install` (or lazily at first boot via docker-entrypoint.sh) against the
# bind-mounted source, so lockfile changes never need an image rebuild. The
# heavy local-ml group (torch) therefore lives only inside that volume - this
# image stays small. The production image is a different file entirely
# (backend/Dockerfile): lean groups, no reload, non-root user.
#
# Runs as root on purpose: dev-only, and it keeps files written into the bind
# mount (var/uploads) owned by the host user through VirtioFS.
FROM python:3.12.14-slim

COPY --from=ghcr.io/astral-sh/uv:0.5.31 /uv /uvx /bin/

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:${PATH}" \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    WATCHFILES_FORCE_POLLING=1

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# The eval gate stamps eval_runs.git_sha by shelling out to git; hosts and CI
# always have it, so the dev container must too.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/*

EXPOSE 8000

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
