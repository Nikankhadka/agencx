# Dev container for the fully containerized local stack (F-3). Toolchain only:
# dependencies live in the wren-node-modules named volume and are installed by
# `make install` (npm ci) or lazily at first boot; source arrives via the
# ./frontend bind mount so edits hot-reload. The production image is
# frontend/Dockerfile (B-4) - self-contained, and the artifact that ships.
FROM node:22.23.2-bookworm-slim

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    WATCHPACK_POLLING=true \
    PATH="/app/node_modules/.bin:${PATH}"

EXPOSE 3000

# First boot self-heals when install has not run yet; npm ci is deliberately
# NOT re-run on every boot (slow) - `make install` refreshes deps explicitly.
CMD ["sh", "-c", "[ -d node_modules/next ] || npm ci; exec next dev --hostname 0.0.0.0"]
